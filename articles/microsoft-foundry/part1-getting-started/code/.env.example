# Copy this file to `.env` and fill in your own values.

# Azure subscription / resource identifiers (used by management-plane scripts)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_FOUNDRY_RESOURCE_NAME=
AZURE_FOUNDRY_PROJECT_NAME=
AZURE_LOCATION=eastus

# Model deployment (used by 05_deploy_model.py, a management-plane call too)
MODEL_DEPLOYMENT=gpt-5.1-mini
MODEL_VERSION=2025-04-14
MODEL_SKU_NAME=GlobalStandard
MODEL_SKU_CAPACITY=10

# Data-plane connection (used by AIProjectClient scripts)
AZURE_AI_PROJECT_ENDPOINT=https://xxx.services.ai.azure.com/api/projects/yyy
