FOUNDRY_PROJECT_ENDPOINT=https://<your-ai-resource>.services.ai.azure.com/api/projects/<your-project>

# The exact name of your existing registered agent, not a name prefix.
FOUNDRY_AGENT_NAME=support-agent

# The deployment name of the model used to analyze traces (the "Judge model").
FOUNDRY_MODEL_NAME=gpt-4.1-mini

# Set after 01_create_monitor.py prints it, so later scripts can reuse the same monitor.
FOUNDRY_INSIGHT_MONITOR_ID=

# Set after you pick an Insight to resolve in 03_review_insights.py.
FOUNDRY_INSIGHT_ID=
