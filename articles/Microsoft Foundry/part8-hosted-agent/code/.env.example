AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
MODEL_DEPLOYMENT=<model-deployment-name>
LOCAL_AGENT_BASE_URL=http://127.0.0.1:8088
TEST_PROMPT=Read data/quantum-computing-rag-test.md and summarize how quantum computing differs from classical computing.

# Container deployment (03_deploy_container.py)
ACR_NAME=<your-acr-name>
CONTAINER_AGENT_NAME=mcp-knowledge-agent-container
CONTAINER_IMAGE_NAME=mcp-knowledge-agent
CONTAINER_IMAGE_TAG=latest
CONTAINER_CPU=1
CONTAINER_MEMORY=2Gi
# CONTAINER_REGISTRY_CONNECTION_ID=<optional-foundry-private-registry-connection-id>

# Azure Developer CLI deployment (04_deploy_azd.py)
AZD_AGENT_NAME=mcp-knowledge-agent-azd
AZD_ENV_NAME=mcp-knowledge-agent-dev
# AZD_PROJECT_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
AZD_SKIP_INIT=false
AZD_RUN_LOCAL_TEST=false
